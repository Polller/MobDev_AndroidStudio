<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Music Generation Type"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:paddingBottom="16dp" />

        <!-- Image -->
        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/music_generation_type"
            android:contentDescription="Music Generation Image" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mameen Band: 87% hiring"
            android:textSize="18sp"
            android:textColor="#333333"
            android:paddingTop="20dp"
            android:paddingBottom="16dp" />

        <!-- Generation Types -->
        <TextView
            android:id="@+id/textViewGen90s"
            style="@style/GenreItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎶 90s" />

        <TextView
            android:id="@+id/textViewGen80s"
            style="@style/GenreItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📼 80s" />

        <TextView
            android:id="@+id/textViewGen20s"
            style="@style/GenreItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 20s" />

        <TextView
            android:id="@+id/textViewGen70s"
            style="@style/GenreItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📻 70s" />

        <TextView
            android:id="@+id/textViewGen60s"
            style="@style/GenreItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕺 60s" />
    </LinearLayout>
</ScrollView>
